  "dynamicRoutes": [
    {
      "page": "/admin/sessions/[code]",
      "regex": "^/admin/sessions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcode": "nxtPcode"
      },
      "namedRegex": "^/admin/sessions/(?<nxtPcode>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/sessions/[code]",
      "regex": "^/api/sessions/([^/]+?)(?:/)?$",
